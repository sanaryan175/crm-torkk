generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum ContactStatus {
  active
  inactive
  blocked
}

enum ContactSource {
  website
  referral
  cold_outreach
  event
  partner
  other
}

enum DealStage {
  new
  contacted
  demo_scheduled
  proposal_sent
  negotiation
  closed_won
  closed_lost
}

enum DealPriority {
  low
  medium
  high
}

enum DealCloseReason {
  won
  lost
  no_decision
  cancelled
}

enum ActivityType {
  call
  email
  meeting
  note
  task
}

enum AuditAction {
  create
  update
  delete
  login
  logout
  invite_sent
  invite_accepted
  invite_revoked
  permission_changed
  role_changed
}

// ─── Multi-Tenant Core ────────────────────────────────────────────────────────

model Organization {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  logo          String?
  industry      String?
  website       String?
  phone         String?
  address       String?
  country       String   @default("US")
  currency      String   @default("USD")
  timezone      String   @default("UTC")
  dateFormat    String   @default("YYYY-MM-DD") @map("date_format")
  timeFormat    String   @default("24h") @map("time_format")
  fiscalYear    Int      @default(1) @map("fiscal_year") // month number 1-12
  companySize   String?  @map("company_size")
  businessHours String?  @map("business_hours")
  isActive      Boolean  @default(true) @map("is_active")
  setupComplete Boolean  @default(false) @map("setup_complete")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  users       User[]
  roles       Role[]
  permissions Permission[]
  invitations Invitation[]
  contacts    Contact[]
  deals       Deal[]
  activities  Activity[]
  auditLogs   AuditLog[]
  files       FileEntry[]

  // CRM extensions
  leads               Lead[]
  companies           Company[]
  timelines           CustomerTimeline[]
  followUps           FollowUp[]
  emailTrackings      EmailTracking[]
  quotes              Quote[]
  quoteItems          QuoteItem[]
  invoices            Invoice[]
  invoiceItems        InvoiceItem[]
  payments            Payment[]
  contracts           Contract[]
  // Sales
  salesOrders         SalesOrder[]
  salesOrderItems     SalesOrderItem[]
  salesTargets        SalesTarget[]
  commissionRules     CommissionRule[]
  commissions         Commission[]
  // Marketing
  campaigns           Campaign[]
  campaignRecipients  CampaignRecipient[]
  coupons             Coupon[]
  referrals           Referral[]
  // Support
  tickets             Ticket[]
  ticketComments      TicketComment[]
  knowledgeArticles   KnowledgeArticle[]
  slaPolicies         SlaPolicy[]
  // Projects
  projects            Project[]
  projectMembers      ProjectMember[]
  projectMilestones   ProjectMilestone[]
  projectTasks        ProjectTask[]
  timeEntries         TimeEntry[]
  // HRMS
  departments         Department[]
  employees           Employee[]
  attendance          Attendance[]
  leaves              Leave[]
  payrollRuns         PayrollRun[]
  payrollEntries      PayrollEntry[]
  jobPostings         JobPosting[]
  applications        Application[]
  interviews          Interview[]
  offerLetters        OfferLetter[]
  performanceReviews  PerformanceReview[]
  promotions          Promotion[]
  trainings           Training[]
  trainingEnrollments TrainingEnrollment[]
  employeeDocuments   EmployeeDocument[]
  employeeExits       EmployeeExit[]
  // Finance
  expenses            Expense[]
  incomes             Income[]
  budgets             Budget[]
  bankAccounts        BankAccount[]
  bankTransactions    BankTransaction[]
  taxRates            TaxRate[]
  // Inventory & Procurement
  products            Product[]
  productCategories   ProductCategory[]
  warehouses          Warehouse[]
  stockMovements      StockMovement[]
  vendors             Vendor[]
  purchaseRequests    PurchaseRequest[]
  rfqs                Rfq[]
  purchaseOrders      PurchaseOrder[]
  purchaseOrderItems  PurchaseOrderItem[]
  vendorPayments      VendorPayment[]
  // Assets
  companyAssets       CompanyAsset[]
  assetMaintenances   AssetMaintenance[]
  depreciationEntries DepreciationEntry[]
  // Documents
  documents           Document[]
  documentVersions    DocumentVersion[]
  // Calendar & Communication
  calendarEvents      CalendarEvent[]
  eventAttendees      EventAttendee[]
  reminders           Reminder[]
  chatMessages        ChatMessage[]
  announcements       Announcement[]
  appNotifications    AppNotification[]
  // Workflow
  approvalFlows       ApprovalFlow[]
  approvalRequests    ApprovalRequest[]
  scheduledJobs       ScheduledJob[]
  businessRules       BusinessRule[]
  // Security
  apiKeys             ApiKey[]
  loginHistories      LoginHistory[]
  twoFactorSettings   TwoFactorSetting[]
  // Multi-brand
  brands              Brand[]
  branches            Branch[]
  subscriptions       Subscription[]

  @@map("organizations")
}

// ─── RBAC Core ────────────────────────────────────────────────────────────────

model Role {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String // e.g. "owner", "admin", "sales_manager"
  displayName    String   @map("display_name") // e.g. "Sales Manager"
  description    String?
  isSystem       Boolean  @default(false) @map("is_system") // built-in, not deletable
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]
  invitations     Invitation[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  resource       String // e.g. "deal", "contact", "user"
  action         String // e.g. "create", "read", "update", "delete"
  name           String // e.g. "deal.create" (computed: resource.action)
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  roleId             String    @map("role_id")
  name               String
  email              String
  password           String
  isActive           Boolean   @default(true) @map("is_active")
  avatar             String?
  isOwner            Boolean   @default(false) @map("is_owner")
  onboardingComplete Boolean   @default(true) @map("onboarding_complete")
  profileCompleted   Boolean   @default(false) @map("profile_completed")
  timezone           String    @default("UTC")
  language           String    @default("en")
  emailNotifications Boolean   @default(true) @map("email_notifications")
  taskReminders      Boolean   @default(true) @map("task_reminders")
  meetingReminders   Boolean   @default(true) @map("meeting_reminders")
  phone              String?
  jobTitle           String?   @map("job_title")
  dateFormat         String    @default("MM/DD/YYYY") @map("date_format")
  timeFormat         String    @default("12h") @map("time_format")
  lastLoginAt        DateTime? @map("last_login_at")
  resetPin           String?   @map("reset_pin")
  resetPinExpires    DateTime? @map("reset_pin_expires")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role               Role         @relation(fields: [roleId], references: [id])
  sentInvitations    Invitation[] @relation("InvitationSender")
  assignedContacts   Contact[]    @relation("ContactAssignee")
  createdContacts    Contact[]    @relation("ContactCreator")
  assignedDeals      Deal[]       @relation("DealAssignee")
  createdDeals       Deal[]       @relation("DealCreator")
  assignedActivities Activity[]   @relation("ActivityAssignee")
  createdActivities  Activity[]   @relation("ActivityCreator")
  auditLogs          AuditLog[]
  uploadedFiles      FileEntry[]

  // CRM extension assignments
  assignedLeads       Lead[]              @relation("LeadAssignee")
  assignedFollowUps   FollowUp[]          @relation("FollowUpAssignee")
  ownedCompanies      Company[]           @relation("CompanyOwner")
  assignedTargets     SalesTarget[]       @relation("TargetAssignee")
  commissions         Commission[]        @relation("CommissionOwner")
  assignedTickets     Ticket[]            @relation("TicketAssignee")
  managedProjects     Project[]           @relation("ProjectManager")
  assignedTasks       ProjectTask[]       @relation("TaskAssignee")
  conductedInterviews Interview[]         @relation("Interviewer")
  givenReviews        PerformanceReview[] @relation("Reviewer")
  reimbursedExpenses  Expense[]           @relation("ExpenseReimburser")
  sentMessages        ChatMessage[]       @relation("ChatSender")
  receivedMessages    ChatMessage[]       @relation("ChatReceiver")
  loginHistory        LoginHistory[]

  @@unique([organizationId, email])
  @@map("users")
}

// ─── Invitations ──────────────────────────────────────────────────────────────

model Invitation {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  email          String
  roleId         String           @map("role_id")
  invitedById    String           @map("invited_by_id")
  token          String           @unique // secure random token (hashed in DB)
  tokenPrefix    String?          @map("token_prefix")
  status         InvitationStatus @default(pending)
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([tokenPrefix, status])
  @@map("invitations")
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  userId         String?     @map("user_id")
  action         AuditAction
  resource       String // e.g. "deal", "user", "contact"
  resourceId     String?     @map("resource_id")
  metadata       Json? // before/after state, IP, etc.
  ipAddress      String?     @map("ip_address")
  userAgent      String?     @map("user_agent")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─── CRM Models (all tenant-scoped) ──────────────────────────────────────────

model Contact {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  email          String
  phone          String?
  company        String?
  companyId      String?       @map("company_id")
  jobTitle       String?       @map("job_title")
  status         ContactStatus @default(active)
  source         ContactSource @default(other)
  tags           String[]
  notes          String?
  assignedToId   String?       @map("assigned_to_id")
  createdById    String        @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  linkedCompany Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo    User?        @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy     User         @relation("ContactCreator", fields: [createdById], references: [id])
  deals         Deal[]
  activities    Activity[]

  @@map("contacts")
}

model Deal {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  title             String
  contactId         String?          @map("contact_id")
  companyId         String?          @map("company_id")
  company           String?
  value             Float // Always in organization's base currency
  stage             DealStage        @default(new)
  priority          DealPriority     @default(medium)
  expectedCloseDate DateTime?        @map("expected_close_date")
  closeReason       DealCloseReason? @map("close_reason")
  closedAt          DateTime?        @map("closed_at")
  assignedToId      String?          @map("assigned_to_id")
  createdById       String           @map("created_by_id")
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  linkedCompany Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo    User?        @relation("DealAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy     User         @relation("DealCreator", fields: [createdById], references: [id])
  activities    Activity[]

  @@map("deals")
}

model Activity {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  type           ActivityType
  subject        String
  description    String?
  contactId      String?      @map("contact_id")
  dealId         String?      @map("deal_id")
  assignedToId   String?      @map("assigned_to_id")
  dueDate        DateTime?    @map("due_date")
  completed      Boolean      @default(false)
  completedAt    DateTime?    @map("completed_at")
  createdById    String       @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("ActivityAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("ActivityCreator", fields: [createdById], references: [id])

  @@map("activities")
}

// ─── File Storage ──────────────────────────────────────────────────────────────

model FileEntry {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  uploadedById   String   @map("uploaded_by_id")
  name           String
  originalName   String   @map("original_name")
  mimeType       String   @map("mime_type")
  size           Int
  folder         String   @default("/")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@unique([organizationId, name])
  @@map("file_entries")
}

// ─── CRM Extensions ───────────────────────────────────────────────────────────

enum LeadStatus {
  new
  contacted
  qualified
  unqualified
  converted
  lost
}

enum LeadSource {
  website
  referral
  cold_outreach
  event
  partner
  other
  social_media
  paid_ads
}

model Lead {
  id                 String     @id @default(uuid())
  organizationId     String     @map("organization_id")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  email              String
  phone              String?
  company            String?
  jobTitle           String?    @map("job_title")
  source             LeadSource @default(other)
  status             LeadStatus @default(new)
  tags               String[]
  value              Float?
  notes              String?
  assignedToId       String?    @map("assigned_to_id")
  convertedContactId String?    @map("converted_contact_id")
  convertedDealId    String?    @map("converted_deal_id")
  createdById        String     @map("created_by_id")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@map("leads")
}

model Company {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  industry       String?
  website        String?
  phone          String?
  email          String?
  address        String?
  city           String?
  state          String?
  country        String?
  size           String?
  tags           String[]
  description    String?
  ownerId        String?  @map("owner_id")
  notes          String?
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  deals        Deal[]

  @@map("companies")
}

enum FollowUpStatus {
  pending
  done
  cancelled
}

model FollowUp {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  contactId      String?        @map("contact_id")
  dealId         String?        @map("deal_id")
  leadId         String?        @map("lead_id")
  title          String
  notes          String?
  scheduledAt    DateTime       @map("scheduled_at")
  status         FollowUpStatus @default(pending)
  assignedToId   String?        @map("assigned_to_id")
  completedAt    DateTime?      @map("completed_at")
  createdById    String         @map("created_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@map("follow_ups")
}

model CustomerTimeline {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  contactId      String?  @map("contact_id")
  dealId         String?  @map("deal_id")
  companyId      String?  @map("company_id")
  type           String
  title          String
  content        String?
  metadata       Json?
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("customer_timelines")
}

model EmailTracking {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  activityId     String?   @map("activity_id")
  toEmail        String    @map("to_email")
  subject        String?
  sentAt         DateTime  @default(now()) @map("sent_at")
  openedAt       DateTime? @map("opened_at")
  openedCount    Int       @default(0) @map("opened_count")
  clickedCount   Int       @default(0) @map("clicked_count")
  metadata       Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("email_trackings")
}

// ─── Quotations / Invoices / Contracts ────────────────────────────────────────

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  expired
  converted
}

model Quote {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  quoteNumber    String      @map("quote_number")
  contactId      String?     @map("contact_id")
  companyId      String?     @map("company_id")
  dealId         String?     @map("deal_id")
  title          String
  status         QuoteStatus @default(draft)
  issueDate      DateTime    @default(now()) @map("issue_date")
  expiryDate     DateTime?   @map("expiry_date")
  currency       String      @default("USD")
  taxRate        Float       @default(0) @map("tax_rate")
  discount       Float       @default(0)
  subtotal       Float       @default(0)
  taxAmount      Float       @default(0) @map("tax_amount")
  total          Float       @default(0)
  notes          String?
  createdById    String      @map("created_by_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        QuoteItem[]

  @@map("quotes")
}

model QuoteItem {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  quoteId        String  @map("quote_id")
  name           String
  description    String?
  quantity       Float   @default(1)
  unitPrice      Float   @default(0) @map("unit_price")
  taxRate        Float   @default(0) @map("tax_rate")
  lineTotal      Float   @default(0) @map("line_total")
  sortOrder      Int     @default(0) @map("sort_order")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote        Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_items")
}

enum InvoiceStatus {
  draft
  sent
  partial_paid
  paid
  overdue
  cancelled
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  invoiceNumber  String        @map("invoice_number")
  quoteId        String?       @map("quote_id")
  contactId      String?       @map("contact_id")
  companyId      String?       @map("company_id")
  dealId         String?       @map("deal_id")
  status         InvoiceStatus @default(draft)
  issueDate      DateTime      @default(now()) @map("issue_date")
  dueDate        DateTime?     @map("due_date")
  paidAt         DateTime?     @map("paid_at")
  currency       String        @default("USD")
  taxRate        Float         @default(0) @map("tax_rate")
  discount       Float         @default(0)
  subtotal       Float         @default(0)
  taxAmount      Float         @default(0) @map("tax_amount")
  total          Float         @default(0)
  amountPaid     Float         @default(0) @map("amount_paid")
  notes          String?
  createdById    String        @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        InvoiceItem[]
  payments     Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  invoiceId      String  @map("invoice_id")
  name           String
  description    String?
  quantity       Float   @default(1)
  unitPrice      Float   @default(0) @map("unit_price")
  taxRate        Float   @default(0) @map("tax_rate")
  lineTotal      Float   @default(0) @map("line_total")
  sortOrder      Int     @default(0) @map("sort_order")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

enum PaymentMethod {
  cash
  bank_transfer
  card
  upi
  cheque
  other
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  invoiceId      String?       @map("invoice_id")
  amount         Float
  method         PaymentMethod @default(bank_transfer)
  reference      String?
  paidAt         DateTime      @default(now()) @map("paid_at")
  status         PaymentStatus @default(completed)
  notes          String?
  createdById    String        @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@map("payments")
}

enum ContractStatus {
  draft
  active
  expired
  terminated
}

model Contract {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  title          String
  contractNumber String         @map("contract_number")
  type           String?
  status         ContractStatus @default(draft)
  contactId      String?        @map("contact_id")
